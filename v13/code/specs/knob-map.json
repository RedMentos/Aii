 "deviations": {
  "B2.gist_span_min": "Code keeps 4 tokens as the finest gist group (age.GIST_FINE, used for literal/conflict refinement §17.6). The value 3 has not been measured against 4; calibrate (WP-KAL) before changing.",
  "FOCAL.slot_target": "focal_slots is an operator knob with default 4 (config.DEFAULTS); the blueprint value 6 is not yet measured on the phone. The user can raise it with :set focal_slots.",
  "C3.native_token_budget_default": "answer_tokens is the user-facing answer budget (default 256); the blueprint 64 is a native-report budget. Not measured as equivalent; kept as is until a C3 report path exists.",
  "M.utility.task_success": "C5 action learning (WP-N4) uses BOOT weights that rank explicit human approval above self-measured task success at Age 0; not calibrated yet.",
  "M.utility.human_preference": "C5 action learning (WP-N4) weights explicit human approval 1.0 at Age 0 (BOOT, not calibrated).",
  "FF.learn_gain": "fastforward.LR is the NLMS step size of the fast-forward predictor (BOOT 0.3); whether it is the same quantity as FF.learn_gain is an interpretation, and 0.55 has not been tested."
 }
