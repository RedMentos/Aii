+void llama_context::opt_set_soft_labels(const int32_t * ids, const float * probs, int32_t k, int64_t n_rows) {
+    GGML_ASSERT(k >= 0 && n_rows >= 0);
+    opt_soft_k = n_rows > 0 ? k : 0;
+    opt_soft_ids.assign(ids, ids + (size_t) (n_rows*opt_soft_k));
+    opt_soft_p.assign(probs, probs + (size_t) (n_rows*opt_soft_k));
+}
