+
+def _owned_group_exists(pgid):
+    """Check the group created by Popen(start_new_session=True), not other jobs."""
+    try:
+        os.killpg(pgid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        # Fail closed: a group we cannot inspect is not known to be gone.
+        return True
+    return True
+
+
+def _cleanup_owned_group(pgid, grace=1.0):
+    """Bounded cleanup for descendants that outlive the direct child.
+
+    Reaping the Popen leader alone does NOT prove its process group has exited.
+    Never report a successful native cohort if any group member survived it.
+    This only accepts a PGID returned from our own start_new_session child.
+    """
+    if not _owned_group_exists(pgid):
+        return {'owned_group_residue_detected': False, 'owned_group_absent': True}
+    try:
+        os.killpg(pgid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+    deadline = time.monotonic() + grace
+    while time.monotonic() < deadline and _owned_group_exists(pgid):
+        time.sleep(min(.05, max(0, deadline - time.monotonic())))
+    if _owned_group_exists(pgid):
+        try:
+            os.killpg(pgid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+    deadline = time.monotonic() + grace
+    while time.monotonic() < deadline and _owned_group_exists(pgid):
+        time.sleep(min(.05, max(0, deadline - time.monotonic())))
+    return {'owned_group_residue_detected': True,
+            'owned_group_absent': not _owned_group_exists(pgid)}
+
+
