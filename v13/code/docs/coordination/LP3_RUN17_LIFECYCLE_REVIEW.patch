+def _reap_interrupted_owned_child(proc, grace=5):
+    """Stop/reap our own still-running child before the advisory lock is released.
+
+    The group was created by Popen(start_new_session=True); this function must
+    never be used for a PID that did not come from this launch. A bounded wait
+    prevents an interrupted wrapper from waiting forever after SIGKILL.
+    """
+    if proc.poll() is not None:
+        return proc.returncode
+    try:
+        os.killpg(proc.pid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+    try:
