+def sha256_file(path, chunk_size=1024 * 1024):
+    """Bounded-memory digest for potentially large native stdout/stderr logs."""
+    h = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for chunk in iter(lambda: stream.read(chunk_size), b''):
+            h.update(chunk)
+    return h.hexdigest()
