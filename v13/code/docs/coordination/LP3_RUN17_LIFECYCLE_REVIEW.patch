+# Run17 independent adversarial review: interrupted wait must not leave a native child alive.
+class SerialCohortInterruptionTests(unittest.TestCase):
+    setUp = SerialCohortTests.setUp
+    call = SerialCohortTests.call
+    def test_interrupted_wait_reaps_owned_child_before_unlock(self):
+        import signal
+        self.candidate.write_text('import time\ntime.sleep(30)\n')
+        original_popen = mod.subprocess.Popen
+        children = []
+        def capture(*args, **kwargs):
+            proc = original_popen(*args, **kwargs)
+            children.append(proc)
+            return proc
+        try:
+            with patch.object(mod, 'check', return_value=self.ready), \
+                 patch.object(mod.subprocess, 'Popen', side_effect=capture), \
+                 patch.object(mod, '_wait_owned_child', side_effect=KeyboardInterrupt):
+                with self.assertRaises(KeyboardInterrupt):
+                    self.call()
+            self.assertEqual(len(children), 1)
+            self.assertIsNotNone(children[0].poll(), 'interrupted launch leaked an owned native child')
+            status = json.loads((self.evidence / 'launch_status.json').read_text())
+            self.assertEqual(status['status'], 'WRAPPER_OR_AUDIT_FAILED_PRESERVED')
+            self.assertTrue(status['owned_child_cleanup_attempted'])
+            self.assertIn('native_log_sha256', status)
+        finally:
+            for proc in children:
+                if proc.poll() is None:
+                    os.killpg(proc.pid, signal.SIGKILL)
+                    proc.wait(timeout=5)
+
+class SerialCohortBoundedWaitTests(unittest.TestCase):
+    def test_timeout_escalation_keeps_final_wait_bounded(self):
+        from subprocess import TimeoutExpired
+        class FakeProc:
+            pid = 912345
+            def __init__(self):
+                self.timeouts = []
+            def poll(self):
+                return None
+            def wait(self, timeout=None):
+                self.timeouts.append(timeout)
+                if len(self.timeouts) < 3:
+                    raise TimeoutExpired('synthetic', timeout)
+                return -9
+        proc = FakeProc()
+        with patch.object(mod.os, 'killpg') as killpg:
+            rc, timed_out = mod._wait_owned_child(proc, timeout=1, grace=0.5)
+        self.assertEqual((rc, timed_out), (-9, True))
+        self.assertEqual(proc.timeouts, [1, 0.5, 0.5])
+        self.assertEqual(killpg.call_count, 2)
+
